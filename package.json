{
  "name": "yoya-ui-monorepo",
  "version": "0.7.0",
  "description": "Monorepo root: workspace wiring, build/report scripts and the example site. The published packages live in packages/.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-packages.mjs && node scripts/compiler-registry.mjs && vite build --config vite.examples.config.js && node scripts/bundle-report.mjs && node scripts/compiler-coverage.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "build:registry": "node scripts/compiler-registry.mjs",
    "build:examples": "vite build --config vite.examples.config.js",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "report:bundle:write": "node scripts/bundle-report.mjs --write",
    "report:compile": "node scripts/compiler-coverage.mjs",
    "report:compile:write": "node scripts/compiler-coverage.mjs --write",
    "report:bench": "node scripts/benchmark-report.mjs",
    "report:shapes": "node scripts/benchmark-shapes.mjs",
    "report:bench:write": "node scripts/benchmark-report.mjs --write",
    "report:bench:import": "node scripts/benchmark-report.mjs --import",
    "report:bench:html": "node scripts/benchmark-report-html.mjs",
    "report:bench:html:write": "node scripts/benchmark-report-html.mjs --write",
    "report:bench:html:check": "node scripts/benchmark-report-html.mjs --check",
    "perf:selection": "node scripts/perf-selection-cost.mjs",
    "examples:html": "vite --config vite.examples.config.js --host 0.0.0.0",
    "examples:i18n": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5174",
    "examples:layout": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5175",
    "examples:svg": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5176",
    "examples:router": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5177",
    "examples:admin": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5179",
    "examples:components": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5178",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/yoya-core/tsconfig.json",
    "test:types": "npm run typecheck"
  },
  "keywords": [
    "vite",
    "vanilla-js",
    "ui",
    "web-components",
    "frontend"
  ],
  "author": "zhanglj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyaflow/yoya-ui.git"
  },
  "homepage": "https://github.com/yoyaflow/yoya-ui#readme",
  "bugs": {
    "url": "https://github.com/yoyaflow/yoya-ui/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ],
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@preact/signals-core": "^1.14.4",
    "@toast-ui/editor": "^3.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ag-grid-community": "^36.1.0",
    "codemirror": "^6.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "magic-string": "^1.4.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "quill": "^2.0.3",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "unplugin": "^3.4.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
