{
  "name": "@yoyaflow/yoya-ui",
  "version": "0.7.0",
  "description": "A browser-native JS UI library with declarative HTML authoring: component library, router, i18n, theming and layout, works with or without a build tool, SSR-ready.",
  "type": "module",
  "private": false,
  "main": "./dist/yoya.ui-router.full.js",
  "module": "./dist/yoya.ui-router.full.js",
  "style": "./dist/yoya.ui.css",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/yoya.ui-router.full.js"
    },
    "./core": {
      "types": "./types/yoya.core.d.ts",
      "import": "./dist/yoya.core.js"
    },
    "./api": {
      "types": "./types/yoya.api.d.ts",
      "import": "./dist/yoya.api.js"
    },
    "./ui": {
      "types": "./types/yoya.ui.d.ts",
      "import": "./dist/yoya.ui.js"
    },
    "./actions": {
      "types": "./types/yoya.actions.d.ts",
      "import": "./dist/yoya.actions.js"
    },
    "./navigation": {
      "types": "./types/yoya.navigation.d.ts",
      "import": "./dist/yoya.navigation.js"
    },
    "./feedback": {
      "types": "./types/yoya.feedback.d.ts",
      "import": "./dist/yoya.feedback.js"
    },
    "./form": {
      "types": "./types/yoya.form.d.ts",
      "import": "./dist/yoya.form.js"
    },
    "./data-display": {
      "types": "./types/yoya.data-display.d.ts",
      "import": "./dist/yoya.data-display.js"
    },
    "./async": {
      "types": "./types/yoya.async.d.ts",
      "import": "./dist/yoya.async.js"
    },
    "./router": {
      "types": "./types/yoya.router.d.ts",
      "import": "./dist/yoya.router.js"
    },
    "./compiler-runtime": {
      "types": "./types/yoya.compiler-runtime.d.ts",
      "import": "./dist/yoya.compiler-runtime.js"
    },
    "./compiled-registry": {
      "types": "./types/yoya.compiled-registry.d.ts",
      "import": "./dist/yoya.compiled-registry.js"
    },
    "./compiler": {
      "types": "./types/yoya.compiler.d.ts",
      "import": "./dist/yoya.compiler.js"
    },
    "./echart": {
      "types": "./types/yoya.echart.d.ts",
      "import": "./dist/yoya.echart.js"
    },
    "./three": {
      "types": "./types/yoya.three.d.ts",
      "import": "./dist/yoya.three.js"
    },
    "./devtools": {
      "types": "./types/yoya.devtools.d.ts",
      "import": "./dist/yoya.devtools.js"
    },
    "./ui.css": "./dist/yoya.ui.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "yoya-compiler": "./dist/yoya.compiler.js"
  },
  "files": [
    "dist",
    "types",
    "!types/*.test-d.ts",
    "!dist/examples",
    "LICENSES",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-entries.mjs && node scripts/compiler-registry.mjs && vite build --config vite.examples.config.js && node scripts/copy-example-modules.mjs && node scripts/bundle-report.mjs && node scripts/compiler-coverage.mjs",
    "build:entries": "node scripts/build-entries.mjs",
    "build:registry": "node scripts/compiler-registry.mjs",
    "build:examples": "vite build --config vite.examples.config.js && node scripts/copy-example-modules.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "report:bundle:write": "node scripts/bundle-report.mjs --write",
    "report:compile": "node scripts/compiler-coverage.mjs",
    "report:compile:write": "node scripts/compiler-coverage.mjs --write",
    "report:bench": "node scripts/benchmark-report.mjs",
    "report:shapes": "node scripts/benchmark-shapes.mjs",
    "report:bench:write": "node scripts/benchmark-report.mjs --write",
    "report:bench:import": "node scripts/benchmark-report.mjs --import",
    "report:bench:html": "node scripts/benchmark-report-html.mjs",
    "report:bench:html:write": "node scripts/benchmark-report-html.mjs --write",
    "report:bench:html:check": "node scripts/benchmark-report-html.mjs --check",
    "perf:selection": "node scripts/perf-selection-cost.mjs",
    "examples:html": "vite --config vite.examples.config.js --host 0.0.0.0",
    "examples:i18n": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5174",
    "examples:layout": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5175",
    "examples:svg": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5176",
    "examples:router": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5177",
    "examples:admin": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5179",
    "examples:components": "vite --config vite.examples.config.js --host 0.0.0.0 --port 5178",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:types": "npm run typecheck"
  },
  "keywords": [
    "vite",
    "vanilla-js",
    "ui",
    "web-components",
    "frontend"
  ],
  "author": "zhanglj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyaflow/yoya-ui.git"
  },
  "homepage": "https://github.com/yoyaflow/yoya-ui#readme",
  "bugs": {
    "url": "https://github.com/yoyaflow/yoya-ui/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "ios_saf >= 17.5"
  ],
  "peerDependencies": {
    "@babel/parser": "^7.29.0"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@preact/signals-core": "^1.14.4",
    "@toast-ui/editor": "^3.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ag-grid-community": "^36.1.0",
    "codemirror": "^6.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "magic-string": "^1.4.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "quill": "^2.0.3",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "unplugin": "^3.4.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
