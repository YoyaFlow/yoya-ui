{
  "name": "yoya-ui",
  "version": "0.1.0",
  "description": "A small vanilla JavaScript UI foundation library for backend and full-stack developers.",
  "type": "module",
  "private": false,
  "main": "./dist/yoya-ui.umd.js",
  "module": "./dist/yoya-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/yoya-ui.es.js",
      "require": "./dist/yoya-ui.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "examples:html": "vite --host 0.0.0.0",
    "examples:i18n": "vite --host 0.0.0.0 --port 5174",
    "examples:layout": "vite --host 0.0.0.0 --port 5175",
    "examples:svg": "vite --host 0.0.0.0 --port 5176",
    "examples:router": "vite --host 0.0.0.0 --port 5177",
    "examples:admin": "vite --host 0.0.0.0 --port 5179",
    "examples:components": "vite --host 0.0.0.0 --port 5178",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vite",
    "vanilla-js",
    "ui",
    "web-components",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
