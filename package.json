{
  "name": "yoya-ui",
  "version": "0.1.0",
  "description": "A browser-native UI library that replaces React/Vue-style frameworks: declarative HTML DSL, component library, router, i18n and layout, with zero build steps.",
  "type": "module",
  "private": false,
  "main": "./dist/yoya-ui.umd.js",
  "module": "./dist/yoya.ui.js",
  "style": "./dist/yoya.ui.css",
  "exports": {
    ".": {
      "import": "./dist/yoya.ui.js",
      "require": "./dist/yoya-ui.umd.js"
    },
    "./core": "./dist/yoya.core.js",
    "./echart": "./dist/yoya.echart.js",
    "./ssr": "./dist/yoya.ssr.js",
    "./ui": "./dist/yoya.ui.js",
    "./ui.css": "./dist/yoya.ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-entries.mjs && vite build --config vite.umd.config.js && vite build --config vite.examples.config.js && node scripts/copy-example-modules.mjs",
    "build:entries": "node scripts/build-entries.mjs",
    "build:examples": "vite build --config vite.examples.config.js && node scripts/copy-example-modules.mjs",
    "build:umd": "vite build --config vite.umd.config.js",
    "examples:html": "vite src/examples --host 0.0.0.0",
    "examples:i18n": "vite src/examples --host 0.0.0.0 --port 5174",
    "examples:layout": "vite src/examples --host 0.0.0.0 --port 5175",
    "examples:svg": "vite src/examples --host 0.0.0.0 --port 5176",
    "examples:router": "vite src/examples --host 0.0.0.0 --port 5177",
    "examples:admin": "vite src/examples --host 0.0.0.0 --port 5179",
    "examples:components": "vite src/examples --host 0.0.0.0 --port 5178",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vite",
    "vanilla-js",
    "ui",
    "web-components",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/signals-core": "^1.14.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
