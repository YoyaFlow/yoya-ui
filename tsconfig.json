{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "yoya-ui": ["./types/index.d.ts"],
      "yoya-ui/core": ["./types/yoya.core.d.ts"],
      "yoya-ui/devtools": ["./types/yoya.devtools.d.ts"],
      "yoya-ui/echart": ["./types/yoya.echart.d.ts"],
      "yoya-ui/three": ["./types/yoya.three.d.ts"],
      "yoya-ui/router": ["./types/yoya.router.d.ts"]
    }
  },
  "include": ["types/**/*.d.ts", "types/**/*.ts"]
}
