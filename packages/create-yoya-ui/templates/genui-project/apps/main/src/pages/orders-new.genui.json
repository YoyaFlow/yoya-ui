{
  "protocol": "yoya-genui",
  "version": "0.2",
  "surfaceId": "orders-new",
  "meta": { "actions": ["orders_create"] },
  "data": {
    "form": {
      "customer": "",
      "amount": "",
      "status": "待付款",
      "owner": ""
    }
  },
  "root": {
    "type": "vCard",
    "children": [
      {
        "type": "vCardHeader",
        "children": [{ "type": "h3", "text": "新建订单（示例：表单 + 一个动作）" }]
      },
      {
        "type": "vCardBody",
        "children": [
          {
            "type": "p",
            "text": "填完点「提交」→ POST @actions:/orders_create（页面只写逻辑名；地址与能力键由宿主补，写进 data/orders.csv）"
          },
          {
            "type": "vInput",
            "props": {
              "name": "customer",
              "placeholder": "客户",
              "value": { "$bind": "/form/customer" }
            }
          },
          {
            "type": "vInput",
            "props": {
              "name": "amount",
              "type": "number",
              "placeholder": "金额",
              "value": { "$bind": "/form/amount" }
            }
          },
          {
            "type": "vSelect",
            "props": {
              "name": "status",
              "placeholder": "状态",
              "value": { "$bind": "/form/status" },
              "options": [
                { "label": "待付款", "value": "待付款" },
                { "label": "已付款", "value": "已付款" },
                { "label": "已发货", "value": "已发货" },
                { "label": "已完成", "value": "已完成" }
              ]
            }
          },
          {
            "type": "vInput",
            "props": {
              "name": "owner",
              "placeholder": "负责人",
              "value": { "$bind": "/form/owner" }
            }
          },
          {
            "type": "vButton",
            "props": { "label": "提交", "variant": "primary" },
            "on": {
              "click": {
                "$action": "send",
                "params": {
                  "action": "@actions:/orders_create",
                  "data": {
                    "customer": "@:/form/customer",
                    "amount": "@:/form/amount",
                    "status": "@:/form/status",
                    "owner": "@:/form/owner"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
